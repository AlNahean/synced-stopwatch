generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Stopwatch {
  id          String        @id @default("singleton")
  isRunning   Boolean       @default(false)
  startTime   DateTime      @default(now())
  elapsedTime BigInt        @default(0) // Stored as milliseconds
  laps        Lap[]
  activities  ActivityLog[]
  updatedAt   DateTime      @updatedAt
}

model Lap {
  id          String    @id @default(cuid())
  stopwatchId String
  stopwatch   Stopwatch @relation(fields: [stopwatchId], references: [id])
  time        BigInt
  createdAt   DateTime  @default(now())
}

model ActivityLog {
  id          String    @id @default(cuid())
  stopwatchId String
  stopwatch   Stopwatch @relation(fields: [stopwatchId], references: [id])
  action      String // e.g., START, PAUSE, LAP, RESET
  details     String? // e.g., Lap time
  comment     String? // Add comments to logs
  createdAt   DateTime  @default(now())
}

model SalatProgress {
  id        String   @id @default(cuid())
  date      String   @unique // format: YYYY-MM-DD
  fajr      Boolean  @default(false)
  dhuhr     Boolean  @default(false)
  asr       Boolean  @default(false)
  maghrib   Boolean  @default(false)
  isha      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkoutProgress {
  id        String   @id @default(cuid())
  date      String   @unique // format: YYYY-MM-DD
  pullups   Int      @default(0)
  pushups   Int      @default(0)
  squats    Int      @default(0)
  expander  Int      @default(0)
  curls     Int      @default(0)
  core      Int      @default(0)
  grip      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SkincareProgress {
  id         String   @id @default(cuid())
  date       String   @unique // format: YYYY-MM-DD
  cleanseM   Boolean  @default(false)
  moistM     Boolean  @default(false)
  protectM   Boolean  @default(false)
  lipsM      Boolean  @default(false)
  cleanseE   Boolean  @default(false)
  moistE     Boolean  @default(false)
  matchaMask Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

